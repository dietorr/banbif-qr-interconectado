---
import { withBase } from '../../lib/url';
import Cobrand from '../ui/Cobrand.astro';
const { compact = false } = Astro.props as { compact?: boolean };
// Completa nombre y rol de cada integrante. Si agregas una foto, súbela a public/equipo/
// y pon la ruta, por ejemplo: photo: '/equipo/ana.jpg'
const team = [
  { name: 'Manuel Cieza', role: 'Subgerente de Canales Digitales para Empresas', photo: '/equipo/manuel-cieza.webp' },
  { name: 'Rodrigo Rivas', role: 'Líder de Producto Recaudaciones y Cobranza', photo: '/equipo/rodrigo-rivas.webp' },
  { name: 'Valeria Alvarado', role: 'Líder de Interoperabilidad y Transferencias', photo: '/equipo/valeria-alvarado.webp' },
  { name: 'Lionel Vera', role: 'Gerente de Aplicaciones Core', photo: '/equipo/lionel-vera.webp' },
  { name: 'Anghy Santos', role: 'Líder de Aplicaciones Core', photo: '/equipo/anghy-santos.webp' },
  { name: 'Victor Conde', role: 'Especialista de Aplicaciones Core', photo: '/equipo/victor-conde.webp' },
];
---
<section class:list={['section', { compact }]} id="equipo">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">El equipo</span>
      <h2 class="h-section">Canales Digitales para <span class="pill pill-cyan">Empresas</span></h2>
      <p class="sub">Las personas detrás de cada cobro conciliado.</p>
      {!compact && <p class="lead">Un equipo de BanBif que decidió ir a la planta, escuchar a los operadores y construir con el cliente. Esto es lo que pasa cuando el banco sale de la oficina y se sube al camión.</p>}
    </div>

    <ul class="team">
      {team.map((m, i) => (
        <li class="member reveal" style={`--d:${(i % 3) * 0.08}s`}>
          <div class={`ava-ring ${i % 2 ? 'v-purple' : 'v-cyan'}`}>
            {m.photo
              ? <img class="ava" src={withBase(m.photo)} alt={m.name} loading="lazy" width="112" height="112" />
              : <div class="ava ph" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8.5" r="3.6" fill="currentColor"/><path d="M4.5 20.5c.8-4 3.8-6.2 7.5-6.2s6.7 2.2 7.5 6.2z" fill="currentColor"/></svg>
                </div>}
          </div>
          <h3>{m.name}</h3>
          <p>{m.role}</p>
        </li>
      ))}
    </ul>

    <div class="thanks reveal">
      <Cobrand size={compact ? 20 : 24} />
      <p>Gracias al equipo de Grupo Gloria, por abrirnos su planta, sus oficinas y sus rutas.</p>
    </div>
  </div>
</section>

<style>
  .sub { font-family: var(--font-display); font-size: clamp(18px, 2.6vw, 22px); margin-top: 14px; }
  .team { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .member { flex: 0 0 calc((100% - 12px) / 2); }
  .member { text-align: center; padding: 24px 12px 22px; border-radius: var(--radius); background: var(--surface); transition: transform .4s var(--ease); }
  .member:hover { transform: translateY(-4px); }
  .ava-ring { width: 108px; height: 98px; margin: 0 auto 16px; border-radius: 42% / 48%; overflow: hidden; }
  .v-cyan { background: var(--bb-cyan-light); color: var(--bb-black); }
  .v-purple { background: var(--bb-purple-light); color: var(--bb-black); }
  .ava { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .ph { display: grid; place-items: center; color: var(--bb-black); }
  .member h3 { font-size: 17px; }
  .member p { color: var(--muted); font-size: 14.5px; margin-top: 4px; }
  .thanks { margin-top: clamp(40px, 6vw, 64px); padding: 22px 24px; border-radius: var(--radius); background: var(--surface); display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; color: var(--muted); }
  .thanks p { max-width: 44ch; }
  @media (min-width: 700px) {
    .team { gap: 18px; }
    .member { flex-basis: calc((100% - 36px) / 3); }
    .ava-ring { width: 128px; height: 116px; }
    .thanks { flex-direction: row; justify-content: center; text-align: left; gap: 24px; width: fit-content; margin-inline: auto; }
  }

  /* Modo compacto */
  .compact { padding-block: clamp(40px, 7vw, 80px); }
  .compact .section-head { margin-bottom: 22px; }
  .compact .sub { margin-top: 10px; }
  .compact .team { gap: 8px; }
  .compact .member { flex: 0 0 calc((100% - 16px) / 3); padding: 14px 6px 12px; border-radius: 18px; }
  .compact .ava-ring { width: 72px; height: 66px; margin-bottom: 8px; }
  .compact .member h3 { font-size: 14px; line-height: 1.2; }
  .compact .member p { font-size: 12px; line-height: 1.3; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .compact .thanks { margin-top: 16px; padding: 12px 16px; flex-direction: row; justify-content: center; gap: 12px; text-align: left; font-size: 13.5px; line-height: 1.4; width: 100%; }
  @media (min-width: 700px) {
    .compact .team { gap: 12px; flex-wrap: nowrap; }
    .compact .member { flex: 1 1 0; min-width: 0; padding: 18px 10px 16px; }
    .compact .ava-ring { width: 88px; height: 80px; }
    .compact .member h3 { font-size: 15px; }
    .compact .member p { font-size: 12.5px; }
    .compact .thanks { width: fit-content; margin-top: 24px; }
  }
</style>
