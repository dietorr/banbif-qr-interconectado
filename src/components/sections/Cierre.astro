---
import { withBase } from '../../lib/url';
import Cobrand from '../ui/Cobrand.astro';
import { SITE } from '../../site.config';
const { compact = false } = Astro.props as { compact?: boolean };
---
<section class:list={['closing', { compact }]} id="cierre">
  <div class="container">
    <div class="block">
      <div class="shp s1" aria-hidden="true"></div>
      <div class="shp s2" aria-hidden="true"></div>
      <div class="shp s3" aria-hidden="true"></div>
      <div class="inner">
        <span class="eyebrow reveal">Pago QR interconectado</span>
        <h2 class="reveal" style="--d:.08s">Cobrar es simple. <span class="pill pill-black">Conciliar, también.</span></h2>
        <p class="sub reveal" style="--d:.16s">De no estar en el radar a ser la plataforma que otras empresas reconocen. Eso merece ganar.</p>
        {!compact && <p class="body reveal" style="--d:.22s">Construimos una solución con el cliente, la validamos en ruta y resolvimos lo que de verdad dolía. Gracias por darle una oportunidad a esta historia.</p>}
        <div class="ctas reveal" style="--d:.3s">
          <a class="btn btn-black" href="#video">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>Ver el video otra vez<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
          <a class="btn btn-ghost" href="#inicio">Volver al inicio<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="container">
    <div class="marks" aria-label="BanBif y Grupo Gloria">
      <Cobrand size={26} />
    </div>
    <p class="prod">{SITE.productName}</p>
    <p class="meta">{SITE.team}<span aria-hidden="true"> · </span><br class="br" />Competencia interna BanBif</p>
    {compact
      ? <a class="alt" href={withBase("/completa/")}>Ver la historia completa →</a>
      : <a class="alt" href={withBase("/")}>Versión corta →</a>}
    <p class="legal">Marcas y logos de BanBif y Grupo Gloria usados con autorización. © {SITE.year} BanBif.</p>
  </div>
  <div class="bar" aria-hidden="true"></div>
</footer>

<style>
  .closing { position: relative; padding: var(--section-y) 0; }
  .block { position: relative; overflow: hidden; border-radius: clamp(28px, 5vw, 56px); background: var(--grad); color: #fff; text-align: center; padding: clamp(48px, 9vw, 120px) clamp(20px, 5vw, 64px); }
  .shp { position: absolute; pointer-events: none; border-radius: 42% / 48%; background: var(--bb-black); }
  .s1 { width: clamp(120px, 22vw, 260px); aspect-ratio: 1.12; left: -4%; bottom: -8%; opacity: .9; }
  .s2 { width: clamp(80px, 14vw, 170px); aspect-ratio: 1.12; right: 6%; top: -5%; background: var(--bb-cyan-light); opacity: .35; }
  .s3 { width: clamp(100px, 17vw, 200px); aspect-ratio: 1.12; right: -5%; bottom: 8%; background: var(--bb-purple-light); opacity: .35; }
  .inner { position: relative; display: flex; flex-direction: column; align-items: center; }
  .block .eyebrow { color: #fff; }
  .block .eyebrow::before { background: #fff; }
  h2 { font-size: clamp(38px, 9vw, 88px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; margin-top: 24px; max-width: 14ch; color: #fff; }
  .pill-black { background: var(--bb-black); color: #fff; }
  .sub { font-family: var(--font-display); font-weight: 600; font-size: clamp(18px, 2.6vw, 24px); margin-top: 28px; max-width: 34ch; line-height: 1.4; color: #fff; }
  .body { color: #fff; margin-top: 16px; max-width: 52ch; font-size: clamp(16px, 2vw, 18px); }
  .ctas { display: flex; flex-direction: column; gap: 14px; margin-top: 40px; width: min(100%, 360px); }
  .btn-black { background: var(--bb-black); color: #fff; }
  .btn-black:hover { transform: translateY(-2px); background: var(--surface-2); }
  @media (min-width: 640px) { .ctas { flex-direction: row; width: auto; } .ctas .btn { padding: 0 28px; } }

  .foot { padding: 48px 0 0; text-align: center; background: var(--bb-black); }
  .marks { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; }
  .prod { font-family: var(--font-display); font-weight: 700; font-size: 18px; margin-top: 22px; }
  .meta { color: var(--muted); font-size: 14.5px; margin-top: 8px; line-height: 1.7; }
  .legal { color: var(--muted); font-size: 12.5px; margin: 24px auto 40px; max-width: 56ch; }
  .bar { height: 6px; background: var(--grad); }
  @media (min-width: 700px) { .br { display: none; } }

  .alt { display: inline-block; margin-top: 18px; color: var(--muted); font-size: 14px; text-underline-offset: 3px; }
  .alt:hover { color: var(--text); }
  .compact { padding: clamp(36px, 7vw, 72px) 0; }
  .compact .block { padding: clamp(32px, 6vw, 64px) clamp(20px, 5vw, 64px); }
  .compact h2 { margin-top: 16px; font-size: clamp(32px, 8vw, 64px); }
  .compact .sub { margin-top: 16px; }
  .compact .ctas { margin-top: 24px; }
  .compact + .foot { padding-top: 32px; }
  .compact + .foot .legal { margin-bottom: 28px; }
</style>
