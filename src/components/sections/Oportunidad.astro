---
import BrandMark from '../ui/BrandMark.astro';
const nodos = [
  { n: 'Banco', x: 50, y: 14 },
  { n: 'Fintech', x: 86, y: 50 },
  { n: 'Banco', x: 50, y: 86 },
  { n: 'Fintech', x: 14, y: 50 },
];
const pasos = [
  { t: 'Gloria evaluó el mercado', d: 'Bancos y fintech estaban sobre la mesa.' },
  { t: 'BanBif llegó con algo real', d: 'La experiencia de Recaudaciones, lista para mostrarse.' },
  { t: 'La confianza se convirtió en proyecto', d: 'De una presentación a construir juntos.' },
];
---
<section class="section op" id="oportunidad">
  <div class="container wrap">
    <div class="radar-col">
      <div class="radar" data-inview aria-hidden="true">
        <div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div>
        <div class="cross"></div>
        <div class="sweep"></div>
        <div class="core"></div>
        {nodos.map((n, i) => (
          <span class="nodo" style={`left:${n.x}%;top:${n.y}%;--i:${i}`}><i></i>{n.n}</span>
        ))}
        <div class="ban"><BrandMark brand="banbif" variant="blanco" size={22} /></div>
      </div>
      <p class="cap" aria-hidden="true">El radar de Gloria</p>
    </div>

    <div class="texto">
      <span class="eyebrow">La oportunidad</span>
      <h2 class="h-section">BanBif no estaba en el radar</h2>
      <p class="lead">Y entonces mostramos lo que ya habíamos construido.</p>
      <p class="cuerpo reveal">Gloria buscaba una solución y evaluó bancos y fintech. BanBif no estaba en su radar. Pero teníamos algo que decir: ya veníamos construyendo una base sólida en el producto de Recaudaciones. Se la mostramos, y esa propuesta concreta cambió la conversación.</p>

      <blockquote class="cita reveal">
        <svg class="q" viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true"><path d="M4 17.5c0-4.6 2-8 6-10l1 1.6c-2.2 1.3-3.2 2.8-3.3 4.4H10V18H4zm9 0c0-4.6 2-8 6-10l1 1.6c-2.2 1.3-3.2 2.8-3.3 4.4H19V18h-6z"/></svg>
        No ganamos la confianza con promesas. <span class="grad-text">La ganamos mostrando lo construido.</span>
      </blockquote>

      <ol class="pasos">
        {pasos.map((p, i) => (
          <li class="reveal" style={`--d:${i * 0.1}s`}>
            <span class="num shape">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{p.t}</h3><p>{p.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; gap: 48px; }
  .radar-col { display: grid; justify-items: center; gap: 14px; }
  .radar { position: relative; width: min(100%, 440px); aspect-ratio: 1; }
  .ring { position: absolute; border-radius: 50%; border: 1px solid rgba(255,255,255,.18); inset: 0; }
  .r1 { background: radial-gradient(circle, rgba(32,166,255,.1), rgba(32,166,255,.02) 70%); }
  .r2 { inset: 17%; border-color: rgba(255,255,255,.15); }
  .r3 { inset: 34%; border-color: rgba(255,255,255,.15); }
  .cross { position: absolute; inset: 0; background: linear-gradient(var(--line), var(--line)) center/1px 100% no-repeat, linear-gradient(var(--line), var(--line)) center/100% 1px no-repeat; }
  .sweep { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, rgba(32,166,255,0) 0deg, rgba(32,166,255,0) 270deg, rgba(32,166,255,.4) 360deg); animation: oportunidad-spin 5s linear infinite; mask: radial-gradient(circle, #000 69%, transparent 70%); -webkit-mask: radial-gradient(circle, #000 69%, transparent 70%); }
  @keyframes oportunidad-spin { to { transform: rotate(360deg); } }
  .nodo { position: absolute; transform: translate(-50%, -50%); display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--bb-white); background: var(--bb-black); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.85); border-radius: 999px; padding: 5px 12px; white-space: nowrap; }
  .nodo i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.6); animation: oportunidad-ping 5s linear infinite; animation-delay: calc(var(--i) * 1.25s - 1s); }
  @keyframes oportunidad-ping { 0%, 100% { background: rgba(255,255,255,.6); } 10% { background: var(--cyan); transform: scale(1.5); } 30% { background: rgba(255,255,255,.6); transform: none; } }
  .ban { position: absolute; left: 50%; top: 50%; z-index: 2; display: grid; place-items: center; padding: 14px 22px; border-radius: 22px; background: var(--bb-purple); opacity: .8; transform: translate(-50%, -50%) translate(0, 150%); box-shadow: 0 0 0 0 rgba(146,79,245,0); transition: transform 1.6s var(--ease) .3s, opacity 1s .3s, box-shadow 1.6s .3s; }
  .radar.in-view .ban { transform: translate(-50%, -50%); opacity: 1; box-shadow: 0 0 36px -6px rgba(146,79,245,.55); animation: oportunidad-banglow 3s ease-in-out infinite 2s; }
  @keyframes oportunidad-banglow { 50% { box-shadow: 0 0 46px -4px rgba(146,79,245,.4); } }
  .cap { font-size: 14px; font-weight: 600; color: var(--muted); }

  .cuerpo { color: var(--muted); margin-top: 18px; max-width: 58ch; }
  .cita { margin: 32px 0; padding: 4px 0 4px 24px; font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 3.4vw, 30px); line-height: 1.25; letter-spacing: -0.02em; position: relative; }
  .cita::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 4px; background: linear-gradient(180deg, var(--bb-cyan), 40%, var(--bb-purple)); }
  .q { color: var(--bb-cyan); margin-bottom: 8px; }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .pasos li { display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-top: 1px solid var(--line); }
  .num { font-family: var(--font-display); font-size: 20px; font-weight: 800; line-height: 1; }
  .pasos h3 { font-size: 18px; letter-spacing: -0.01em; }
  .pasos p { color: var(--muted); font-size: 15px; margin-top: 4px; }

  @media (min-width: 1024px) {
    .wrap { grid-template-columns: 1fr 1.05fr; gap: 72px; align-items: center; }
    .radar-col { position: sticky; top: 110px; }
    .nodo { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep { animation: none; }
    .radar .ban { transform: translate(-50%, -50%); opacity: 1; animation: none; }
  }
</style>
