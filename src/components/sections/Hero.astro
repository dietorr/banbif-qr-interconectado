---
import PhoneFrame from '../ui/PhoneFrame.astro';
import BrandMark from '../ui/BrandMark.astro';
import Cobrand from '../ui/Cobrand.astro';

// Cuadrícula QR decorativa (21x21) generada de forma determinista.
const N = 21;
let seed = 7;
const rnd = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const finder = (r: number, c: number) => {
  const inBox = (r0: number, c0: number) => r >= r0 && r < r0 + 7 && c >= c0 && c < c0 + 7;
  for (const [r0, c0] of [[0, 0], [0, N - 7], [N - 7, 0]]) {
    if (inBox(r0, c0)) {
      const y = r - r0, x = c - c0;
      const ring = y === 0 || y === 6 || x === 0 || x === 6;
      const core = y >= 2 && y <= 4 && x >= 2 && x <= 4;
      return ring || core ? 1 : 0;
    }
  }
  const near = (r0: number, c0: number) => r >= r0 - 1 && r <= r0 + 7 && c >= c0 - 1 && c <= c0 + 7;
  if (near(0, 0) || near(0, N - 7) || near(N - 7, 0)) return 0;
  return null;
};
const cells: { x: number; y: number }[] = [];
for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) {
  const f = finder(r, c);
  const on = f === null ? rnd() > 0.52 : f === 1;
  if (on) cells.push({ x: c, y: r });
}
const chips = ['Cualquier billetera', 'Cualquier banco', 'Registro en el ERP', 'Cuadre en línea'];
---
<section class="section hero" id="inicio">

  <div class="container hero-grid">
    <div class="copy">
      <div class="cobrand-line e" style="--i:0">
        <Cobrand size={22} />
        <span class="cb-sep" aria-hidden="true"></span>
        <span class="cb-text">Canales Digitales para Empresas</span>
      </div>
      <h1 class="e" style="--i:1">Cobrar es simple. <span class="pill pill-cyan">Conciliar,</span> también.</h1>
      <p class="sub e" style="--i:2">Pago QR interconectado: la plataforma que cobra en la puerta de la bodega y cuadra en el sistema de Gloria, al mismo tiempo.</p>
      <p class="body e" style="--i:3">Nació de un reto real: Gloria ya cobraba con QR, pero conciliar cada pago era la parte difícil. Lo resolvimos construyéndolo junto a ellos, en su planta, con sus operadores y en ruta.</p>
      <div class="ctas e" style="--i:4">
        <a class="btn btn-primary" href="#video">
          Ver el video
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="#como-funciona">
          Cómo funciona
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
      <p class="micro e" style="--i:5">Lo que estás viendo se probó en un piloto real con 5 camiones en ruta.</p>
      <ul class="chips e" style="--i:6" aria-label="Características">
        {chips.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <div class="visual e" style="--i:3">
      <div class="shapes" aria-hidden="true"><i class="sq s1"></i><i class="sq s2"></i><i class="sq s3"></i></div>
      <div class="stage" data-hero-stage data-state="wait">
        <PhoneFrame label="Simulación: pantalla de cobro con QR que pasa de esperando pago a pago realizado" class="hero-phone">
          <div class="scr">
            <div class="scr-top"><BrandMark brand="banbif" variant="blanco" size={15} /><span class="scr-tag">Nuevo cobro</span></div>
            <div class="qr-wrap">
              <span class="ring r1" aria-hidden="true"></span>
              <span class="ring r2" aria-hidden="true"></span>
              <div class="qr">
                <svg viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges" aria-hidden="true">
                  {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" />)}
                </svg>
                <span class="sweep" aria-hidden="true"></span>
                <span class="qr-ok" aria-hidden="true">
                  <svg viewBox="0 0 52 52" width="64" height="64" fill="none"><circle cx="26" cy="26" r="24" fill="#c4d600"/><path class="tick" d="M15 27l8 8 15-17" stroke="#141925" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/></svg>
                </span>
              </div>
            </div>
            <div class="amount">S/ •••.••</div>
            <div class="status" aria-live="polite">
              <span class="s-wait"><i class="spin"></i>Esperando pago…</span>
              <span class="s-done"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c4d600" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="tick2" d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"/></svg>Pago realizado · Registrado en el ERP</span>
            </div>
            <div class="scr-foot"><span class="app-btn">Cobrar con QR</span><small>Bodega Ejemplo S.A.C.</small></div>
          </div>
        </PhoneFrame>

        <span class="float f1"><i class="pdot"></i>En línea con Gloria</span>
        <span class="float f2 ok"><i class="pdot"></i>Pago confirmado</span>
        <span class="float f3 lt"><i class="pdot pp"></i>Todo cuadra</span>
        <div class="float f4 erp" aria-hidden="true"><small>ERP Gloria</small><b>Registro recibido</b></div>
      </div>
    </div>
  </div>

  <a class="scroll-ind e" style="--i:8" href="#reto" aria-label="Desliza para conocer la historia">
    <span>Desliza para conocer la historia</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </a>
</section>

<style>
  .hero {
    min-height: 100svh; padding-block: calc(60px + env(safe-area-inset-top) + 28px) 72px;
    display: flex; align-items: center; overflow: hidden; isolation: isolate; border-top: 0;
    background: var(--bg);
  }
  .hero::after { /* línea divisoria con el degradé base */
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--grad); opacity: .7;
  }

  .hero-grid { display: grid; gap: 40px; align-items: center; }
  .copy { display: flex; flex-direction: column; align-items: flex-start; }
  h1 {
    font-size: clamp(40px, 11vw, 68px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.08;
    margin-top: 20px; text-wrap: balance;
  }
  .cobrand-line { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .cb-sep { width: 1.5px; height: 28px; background: var(--line-strong); }
  .cb-text { font-size: 14px; font-weight: 600; color: var(--text); }
  @media (max-width: 480px) { .cb-sep { display: none; } .cobrand-line { gap: 10px; } }
  .sub { font-size: clamp(18px, 2.4vw, 21px); color: var(--text); margin-top: 20px; max-width: 52ch; line-height: 1.5; }
  .body { color: var(--muted); font-size: 16px; margin-top: 14px; max-width: 54ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .micro { margin-top: 16px; font-size: 14px; color: var(--muted); display: flex; gap: 8px; align-items: flex-start; }
  .micro::before { content: ''; flex: none; width: 6px; height: 6px; margin-top: 8px; border-radius: 50%; background: var(--ok); }
  .chips { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    font-size: 13px; padding: 6px 12px; border-radius: 999px; color: var(--text);
    border: 1.5px solid rgba(255,255,255,.55); background: transparent; font-weight: 600;
  }

  /* Visual */
  .visual { position: relative; display: flex; justify-content: center; }
  /* Fondo gráfico (pág. 28): formas base que se tocan */
  .shapes { position: absolute; inset: 0; z-index: -1; }
  .sq { position: absolute; display: block; border-radius: 42% / 48%; will-change: transform; }
  .s1 { width: 78%; aspect-ratio: 1.1; right: -14%; top: 2%; background: var(--bb-cyan); rotate: -8deg; animation: hero-drift1 16s ease-in-out infinite alternate; }
  .s2 { width: 56%; aspect-ratio: 1.1; left: -10%; bottom: 0; background: var(--bb-purple); rotate: 10deg; animation: hero-drift2 19s ease-in-out infinite alternate; }
  .s3 { width: 38%; aspect-ratio: 1.1; right: -6%; bottom: 6%; background: var(--bb-cyan-light); rotate: 14deg; animation: hero-drift3 22s ease-in-out infinite alternate; }
  @keyframes hero-drift1 { to { transform: translate3d(-3%, 4%, 0) scale(1.05); } }
  @keyframes hero-drift2 { to { transform: translate3d(4%, -4%, 0) scale(1.06); } }
  @keyframes hero-drift3 { to { transform: translate3d(-5%, -3%, 0) scale(1.08); } }
  .stage { position: relative; padding: 0 18px; }
  .stage :global(.hero-phone) { width: min(280px, 72vw); }

  /* Pantalla (brief pto. 9): barra cyan con logo blanco, botón morado, estado verde */
  .scr { height: 100%; display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--bb-black); }
  .scr-top { align-self: stretch; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 52px 16px 12px; background: var(--bb-cyan); }
  .scr-tag { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 8px; background: var(--bb-white); color: var(--bb-black); }
  .qr-wrap { position: relative; width: 70%; aspect-ratio: 1; margin-top: 4px; }
  .ring { position: absolute; inset: -4px; border-radius: 22px; border: 2px solid var(--bb-cyan); opacity: 0; animation: hero-pulse 3s var(--ease) infinite; }
  .r2 { animation-delay: 1.5s; }
  @keyframes hero-pulse { 0% { transform: scale(.96); opacity: .5; } 100% { transform: scale(1.22); opacity: 0; } }
  .qr {
    position: absolute; inset: 0; background: #fff; border-radius: 18px; padding: 10px; overflow: hidden;
    box-shadow: 0 0 0 1.5px var(--bb-gray), 0 10px 24px -14px rgba(32,166,255,.6);
  }
  .qr > svg { width: 100%; height: 100%; fill: var(--bb-black); transition: opacity .4s, filter .4s; }
  .sweep {
    position: absolute; left: 0; right: 0; top: 0; height: 38%;
    background: linear-gradient(180deg, transparent, rgba(32,166,255,.3), transparent);
    animation: hero-sweep 2.6s ease-in-out infinite; transform: translateY(-100%);
  }
  @keyframes hero-sweep { to { transform: translateY(290%); } }
  .qr-ok { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transform: scale(.7); transition: opacity .4s, transform .5s var(--ease); background: rgba(255,255,255,.6); }
  .tick { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .tick2 { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .amount { font-family: var(--font-mono); font-size: 18px; font-weight: 600; color: var(--bb-black); letter-spacing: .02em; }
  .status { position: relative; align-self: stretch; height: 40px; margin-inline: 14px; }
  .status span {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 8px; text-align: center;
    font-size: 12px; font-weight: 700; line-height: 1.2; padding: 0 10px; border-radius: 12px; color: var(--bb-black);
    transition: opacity .4s, transform .5s var(--ease);
  }
  .s-wait { background: var(--bb-gray); }
  .s-done { background: var(--bb-cyan-light); opacity: 0; transform: translateY(6px); }
  .spin { width: 12px; height: 12px; border-radius: 50%; border: 2px solid #cfcfcf; border-top-color: var(--bb-purple); animation: hero-rot 1s linear infinite; flex: none; }
  @keyframes hero-rot { to { transform: rotate(360deg); } }
  .scr-foot { margin-top: auto; align-self: stretch; padding: 0 14px 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .app-btn { align-self: stretch; text-align: center; background: var(--bb-purple); color: #fff; font-weight: 700; font-size: 13px; padding: 10px 0; border-radius: 8px; }
  .scr-foot small { font-size: 10.5px; color: #5b6070; }

  [data-state='done'] .s-wait { opacity: 0; transform: translateY(-6px); }
  [data-state='done'] .s-done { opacity: 1; transform: none; }
  [data-state='done'] .qr-ok { opacity: 1; transform: none; }
  [data-state='done'] .qr > svg { filter: blur(1.5px); opacity: .5; }
  [data-state='done'] .tick { animation: hero-draw .7s .15s var(--ease) forwards; }
  [data-state='done'] .tick2 { animation: hero-draw .5s .3s var(--ease) forwards; }
  [data-state='done'] .sweep, [data-state='done'] .ring { animation-play-state: paused; opacity: 0; }
  @keyframes hero-draw { to { stroke-dashoffset: 0; } }

  /* Chips flotantes: contenedores blancos / cyan claro, texto negro */
  .float {
    position: absolute; z-index: 4; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    font-size: 12.5px; font-weight: 700; padding: 8px 14px; border-radius: 14px; color: var(--bb-black);
    background: var(--bb-white);
    box-shadow: 0 14px 28px -14px rgba(0,0,0,.55);
    animation: hero-floaty 6s ease-in-out infinite;
  }
  .float.lt { background: var(--bb-cyan-light); }
  .pdot { width: 8px; height: 8px; border-radius: 50%; background: var(--bb-green); flex: none; }
  .pdot.pp { background: var(--bb-purple); }
  .f1 { top: 30%; left: -6%; }
  .f2 { top: 46%; right: -6%; animation-delay: -2s; }
  .f3 { bottom: 14%; left: -2%; animation-delay: -4s; }
  .f4 { display: none; }
  @keyframes hero-floaty { 50% { transform: translateY(-10px); } }

  .scroll-ind {
    position: absolute; left: 50%; bottom: 14px; translate: -50% 0; z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: 2px; text-decoration: none;
    font-size: 12px; color: var(--muted); text-align: center; min-height: 44px;
  }
  .scroll-ind svg { animation: hero-bob 1.8s ease-in-out infinite; }
  @keyframes hero-bob { 50% { transform: translateY(5px); } }

  /* Entrada escalonada */
  .e { opacity: 0; transform: translateY(22px); animation: hero-enter .9s var(--ease) forwards; animation-delay: calc(var(--i, 0) * .09s + .1s); }
  @keyframes hero-enter { to { opacity: 1; transform: none; } }

  @media (max-width: 639px) {
    .body { display: none; }
    .ctas { flex-wrap: nowrap; gap: 8px; width: 100%; }
    .ctas .btn { flex: 1; padding: 0 10px; font-size: 15px; gap: 6px; }
    .sub { font-size: 17px; margin-top: 14px; }
    h1 { margin-top: 16px; }
  }
  @media (max-width: 1023px) {
    .hero { align-items: flex-start; }
    .visual { margin-bottom: -170px; }
    .scroll-ind { display: none; }
  }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: 1.2fr .8fr; gap: 56px; }
    .stage :global(.hero-phone) { width: 310px; }
    .f1 { left: -14%; } .f2 { right: -16%; } .f3 { left: -10%; }
    .f4 {
      display: flex; flex-direction: column; gap: 1px; right: -12%; bottom: 8%; padding: 10px 14px; border-radius: 16px;
      white-space: nowrap; animation-delay: -1s;
    }
    .erp small { font-size: 11px; font-weight: 600; color: #5b6070; }
    .erp b { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .e { opacity: 1; transform: none; animation: none; }
    .sq, .float, .sweep, .ring, .scroll-ind svg { animation: none; }
    .ring { opacity: 0; }
    .tick, .tick2 { stroke-dashoffset: 0; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (stage && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let done = false;
    setInterval(() => {
      if (document.hidden) return;
      done = !done;
      stage.dataset.state = done ? 'done' : 'wait';
    }, 3200);
  }
</script>
