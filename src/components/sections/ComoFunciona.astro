---
import PhoneFrame from '../ui/PhoneFrame.astro';
import BrandMark from '../ui/BrandMark.astro';

const steps = [
  { t: 'Ingresa el RUC', d: 'El distribuidor entrega los productos, abre la app BanBif e ingresa el RUC del cliente.' },
  { t: 'Razón social al instante', d: 'Aparece el nombre del cliente, conectado en línea con Gloria.' },
  { t: 'Define el monto', d: 'Se ingresa el importe de la entrega, sin cálculos aparte.' },
  { t: 'Genera el QR', d: 'Un toque y el código está listo para mostrarse al cliente.' },
  { t: 'Paga desde cualquier billetera o banco', d: 'La tienda escanea y paga con la app que ya usa.' },
  { t: 'Se registra en el ERP', d: 'Pago confirmado, y en ese mismo instante la transacción viaja al sistema de Gloria.' },
  { t: 'Cuadre entre distribuidor y supervisor', d: 'Al terminar la ruta, cada uno consulta su plataforma en línea y todo coincide.' },
];
const chips = { 1: 'En línea con Gloria', 5: 'Pago confirmado ✓', 6: 'Todo cuadra' };

// QR decorativo determinista (25x25) con 3 marcadores de esquina.
const N = 25;
let seed = 7;
const rnd = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;
const inFinder = (x: number, y: number) =>
  (x < 8 && y < 8) || (x >= N - 8 && y < 8) || (x < 8 && y >= N - 8);
let qr = '';
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
  if (!inFinder(x, y) && rnd() > 0.52) qr += `M${x} ${y}h1v1h-1z`;
}
const finders = [[0, 0], [N - 7, 0], [0, N - 7]];
const keys = ['1','2','3','4','5','6','7','8','9','','0','‹'];
const rows = [['Cliente 01','S/ •••'],['Cliente 02','S/ •••'],['Cliente 03','S/ •••'],['Cliente 04','S/ •••']];
---
<section class="section flujo" id="como-funciona" aria-labelledby="flujo-title">
  <div class="container">
    <header class="section-head center reveal">
      <span class="eyebrow">Cómo funciona</span>
      <h2 class="h-section" id="flujo-title">Del RUC al <span class="pill pill-cyan">cuadre</span>, sin fricción</h2>
      <p class="lead">Siete pasos. Una sola operación registrada en ambos lados.</p>
    </header>

    <div class="grid" data-flujo>
      <div class="stage">
        <div class="stage-inner">
          <div class="halo" aria-hidden="true"></div>
          <PhoneFrame label="Simulación de la app BanBif Empresas paso a paso">
            <div class="screens">
              <!-- 1 Ingreso -->
              <div class="scr on s1" data-screen="0">
                <div class="hero-top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body">
                  <h4>Bienvenido</h4>
                  <label class="fld"><small>Usuario</small><span class="inp">distribuidor01</span></label>
                  <label class="fld"><small>Contraseña</small><span class="inp">••••••••</span></label>
                  <span class="btn-app a-press">Ingresar</span>
                </div>
              </div>
              <!-- 2 RUC -->
              <div class="scr s2" data-screen="1">
                <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body">
                  <h4>Nuevo cobro</h4>
                  <label class="fld"><small>RUC del cliente</small>
                    <span class="inp focus"><span class="ph">Ingresa el RUC</span><span class="typed mono">20•••••••••</span><i class="caret"></i></span>
                  </label>
                  <div class="hint"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>Validación en línea con Gloria</div>
                  <span class="btn-app">Buscar cliente</span>
                </div>
              </div>
              <!-- 3 Razón social -->
              <div class="scr s3" data-screen="2">
                <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body">
                  <h4>Nuevo cobro</h4>
                  <div class="fld"><small>Razón social</small>
                    <div class="reveal-box"><span class="skel"></span><span class="name">Bodega Ejemplo S.A.C.</span></div>
                  </div>
                  <div class="fld"><small>RUC</small><span class="inp mono">20•••••••••</span></div>
                  <div class="badge-ok"><i class="dot"></i>Cliente validado · Conectado con Gloria</div>
                  <span class="btn-app">Continuar</span>
                </div>
              </div>
              <!-- 4 Monto -->
              <div class="scr s4" data-screen="3">
                <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body">
                  <small class="lbl">Monto a cobrar</small>
                  <div class="amount mono"><span>S/</span> <span>•</span><span>•</span><span>•</span><span>.</span><span>•</span><span>•</span></div>
                  <div class="keypad">
                    {keys.map((k, i) => <span class="key" style={`--i:${i}`}>{k}</span>)}
                  </div>
                  <span class="btn-app">Generar QR</span>
                </div>
              </div>
              <!-- 5 QR -->
              <div class="scr s5" data-screen="4">
                <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body center">
                  <h4>Muestra este QR al cliente</h4>
                  <div class="qr-wrap">
                    <i class="ring r1"></i><i class="ring r2"></i>
                    <svg class="qr" viewBox={`-1 -1 ${N + 2} ${N + 2}`} shape-rendering="crispEdges" aria-hidden="true">
                      <rect x="-1" y="-1" width={N + 2} height={N + 2} fill="#fff"/>
                      <path d={qr} fill="#141925"/>
                      {finders.map(([x, y]) => (
                        <g transform={`translate(${x} ${y})`}>
                          <rect width="7" height="7" fill="#141925"/><rect x="1" y="1" width="5" height="5" fill="#fff"/><rect x="2" y="2" width="3" height="3" fill="#141925"/>
                        </g>
                      ))}
                    </svg>
                  </div>
                  <p class="help">Puede pagar desde cualquier billetera o banco</p>
                  <div class="wallets" aria-hidden="true">
                    <span style="--c:var(--bb-purple);--t:#fff">B1</span><span style="--c:var(--bb-cyan);--t:#141925">B2</span><span style="--c:var(--bb-purple-light);--t:#141925">B3</span><span style="--c:var(--bb-cyan-light);--t:#141925">B4</span><span style="--c:var(--bb-gray);--t:#141925">+</span>
                  </div>
                  <div class="waiting"><i></i>Esperando pago<span class="dots">…</span></div>
                </div>
              </div>
              <!-- 6 Pago confirmado -->
              <div class="scr s6" data-screen="5">
                <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body center">
                  <div class="check-wrap">
                    <svg viewBox="0 0 52 52" width="100%" height="100%" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle class="c-bg" cx="26" cy="26" r="24"/><circle class="c-ring" cx="26" cy="26" r="23" stroke-width="2.5"/><path class="c-tick" d="M15 27l8 8 14-16" stroke-width="4"/></svg>
                  </div>
                  <h4 class="ttl">Pago realizado</h4>
                  <div class="erp-row">
                    <span class="src"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg></span>
                    <span class="track"><i class="packet"></i></span>
                    <span class="dst"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg><b>ERP Gloria</b><BrandMark brand="gloria" size={14}/></span>
                  </div>
                  <div class="badge-ok st"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Registrado en el ERP</div>
                  <span class="btn-app ghost">Nuevo cobro</span>
                </div>
              </div>
              <!-- 7 Cuadre -->
              <div class="scr s7" data-screen="6">
                <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
                <div class="body">
                  <h4>Mis cobros del día</h4>
                  <div class="tbl">
                    <div class="tr th"><span>Cliente</span><span>Monto</span><span>Estado</span></div>
                    {rows.map(([c, m], i) => (
                      <div class="tr" style={`--i:${i}`}>
                        <span>{c}</span><span class="mono" style="white-space:nowrap">{m}</span>
                        <span class="state"><em class="pend">Pendiente</em><em class="done"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Conciliado</em></span>
                      </div>
                    ))}
                  </div>
                  <span class="btn-app">Cerrar ruta</span>
                </div>
              </div>
            </div>
          </PhoneFrame>
          {Object.entries(chips).map(([i, t]) => <span class="chip" data-chip={i}><i></i>{t}</span>)}
          <div class="dots-nav" aria-hidden="true">{steps.map(() => <i></i>)}</div>
        </div>
      </div>

      <ol class="steps">
        <li class="rail" aria-hidden="true"><i class="fill"></i></li>
        {steps.map((s, i) => (
          <li class="step" data-step={i}>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="txt">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <p class="closing reveal">Un solo flujo. <span class="pill pill-purple">Cada paso deja rastro.</span></p>
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>('[data-flujo]');
  if (grid) {
    const steps = [...grid.querySelectorAll<HTMLElement>('.step')];
    const screens = [...grid.querySelectorAll<HTMLElement>('.scr')];
    const dots = [...grid.querySelectorAll<HTMLElement>('.dots-nav i')];
    const chips = [...grid.querySelectorAll<HTMLElement>('.chip')];
    const stage = grid.querySelector<HTMLElement>('.stage')!;
    const list = grid.querySelector<HTMLElement>('.steps')!;
    const mq = window.matchMedia('(min-width: 900px)');
    const MAP = [1, 2, 3, 4, 4, 5, 6];
    let current = -2;
    const active = new Set<number>();

    const setActive = (n: number) => {
      if (n === current) return;
      current = n;
      // Pantalla 0 = ingreso (antes del paso 1). Los pasos 4 y 5 comparten la pantalla del QR.
      const sc = n < 0 ? 0 : MAP[n];
      screens.forEach((s, i) => { s.classList.toggle('on', i === sc); s.classList.toggle('past', i < sc); });
      screens[4]?.classList.toggle('pay', n === 4);
      steps.forEach((s, i) => s.classList.toggle('is-active', i === n));
      dots.forEach((d, i) => { d.classList.toggle('on', i === n); d.classList.toggle('done', i < n); });
      chips.forEach((c) => c.classList.toggle('show', Number(c.dataset.chip) === n));
    };
    setActive(-1);

    let io: IntersectionObserver | undefined;
    const observe = () => {
      io?.disconnect();
      active.clear();
      const vh = window.innerHeight;
      let margin = '-45% 0px -45% 0px';
      if (!mq.matches) {
        const bottom = Math.round(parseFloat(getComputedStyle(stage).top) + stage.offsetHeight) + 6;
        margin = `-${bottom}px 0px -${Math.max(0, vh - bottom - 44)}px 0px`;
      }
      io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const i = steps.indexOf(e.target as HTMLElement);
          e.isIntersecting ? active.add(i) : active.delete(i);
        }
        if (active.size) setActive(Math.max(...active));
        else {
          const lim = mq.matches ? window.innerHeight * 0.5 : stage.getBoundingClientRect().bottom;
          if (steps[0].getBoundingClientRect().top > lim) setActive(-1);
        }
      }, { rootMargin: margin });
      steps.forEach((s) => io!.observe(s));
    };
    observe();
    mq.addEventListener('change', observe);
    let rt: number | undefined;
    let lastW = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastW && mq.matches === false) return; // evita recalcular con la barra del navegador móvil
      lastW = window.innerWidth;
      clearTimeout(rt); rt = window.setTimeout(observe, 150);
    });

    // Progreso continuo de la barra vertical
    let tick = false;
    const progress = () => {
      tick = false;
      const r = list.getBoundingClientRect();
      const ref = mq.matches ? window.innerHeight / 2 : stage.getBoundingClientRect().bottom;
      const p = Math.min(1, Math.max(0, (ref - r.top) / r.height));
      list.style.setProperty('--p', p.toFixed(3));
    };
    window.addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(progress); } }, { passive: true });
    progress();
  }
</script>

<style>
  .flujo { overflow: clip; }
  .flujo::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 600px; pointer-events: none;
    background: var(--glow); opacity: .35;
  }
  .flujo .container { position: relative; }
  .mono { font-family: var(--font-mono); }

  /* ---------- Layout ---------- */
  .grid { display: flex; flex-direction: column; }
  .stage {
    position: sticky; top: 64px; z-index: 5;
    margin-inline: calc(50% - 50vw); padding: 10px 0 18px;
    background: var(--bg);
    box-shadow: 0 1px 0 var(--line);
  }
  .stage-inner { position: relative; display: grid; justify-items: center; }
  .halo { position: absolute; inset: 8% 0 auto; margin-inline: auto; width: 240px; height: 240px; border-radius: 50%; background: radial-gradient(closest-side, rgba(32,166,255,.28), transparent); filter: blur(10px); }
  .stage :global(.phone) { width: 168px; border-radius: 28px; padding: 6px; position: relative; }
  .stage :global(.phone-notch) { top: 11px; width: 52px; height: 14px; }
  .stage :global(.phone-screen) { border-radius: 22px; container-type: inline-size; background: var(--bb-white); }

  .dots-nav { display: flex; gap: 6px; margin-top: 12px; }
  .dots-nav i { width: 6px; height: 6px; border-radius: 99px; background: var(--line-strong); transition: width .4s var(--ease), background .3s; }
  .dots-nav i.done { background: rgba(32,166,255,.7); }
  .dots-nav i.on { width: 20px; background: var(--bb-cyan); }

  .chip {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0; z-index: 6;
    display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    font-size: 12px; font-weight: 700; padding: 7px 13px; border-radius: 999px;
    background: var(--bb-white); border: 0; color: var(--bb-black);
    box-shadow: 0 12px 30px -10px rgba(0,0,0,.55);
    opacity: 0; transform: translateY(8px) scale(.96); transition: opacity .5s var(--ease), transform .5s var(--ease); pointer-events: none;
  }
  .chip i { width: 7px; height: 7px; border-radius: 50%; background: var(--bb-green); }
  .chip.show { opacity: 1; transform: none; }
  @media (max-width: 899px) { .chip { display: none; } }

  .steps { list-style: none; margin: 0; padding: 0 0 max(40px, calc(100svh - 560px)); display: grid; gap: 14px; position: relative; --p: 0; }
  .rail { display: none; }
  .step {
    display: flex; gap: 16px; align-items: flex-start; padding: 18px 18px 20px;
    border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--surface);
    opacity: .5; transition: opacity .5s var(--ease), border-color .5s, transform .5s var(--ease);
  }
  .step.is-active { opacity: 1; border-color: var(--bb-cyan); }
  .num {
    display: inline-grid; place-items: center; flex: none; min-width: 1.5em; height: 1.2em; padding: 0 .15em;
    font-family: var(--font-display); font-weight: 800; font-size: 28px; line-height: 1; letter-spacing: -.03em;
    border-radius: 42% / 48%; color: var(--muted); box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition: background .4s, color .4s, box-shadow .4s;
  }
  .step.is-active .num { background: var(--bb-cyan); color: var(--bb-black); box-shadow: none; }
  .txt h3 { font-size: 19px; font-weight: 700; letter-spacing: -.01em; }
  .txt p { margin-top: 6px; color: var(--muted); font-size: 15.5px; line-height: 1.5; }
  :global(.no-js) .step { opacity: 1; }

  .closing { text-align: center; font-family: var(--font-display); font-weight: 700; letter-spacing: -.02em; font-size: clamp(26px, 5vw, 44px); line-height: 1.25; margin-top: clamp(24px, 6vw, 72px); }

  /* ---------- Desktop ---------- */
  @media (min-width: 900px) {
    .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 440px); gap: clamp(32px, 6vw, 96px); align-items: start; }
    .stage { order: 2; top: 0; height: 100vh; height: 100svh; margin: 0; padding: 0; background: none; box-shadow: none; display: grid; align-items: center; }
    .stage-inner { transform: translateY(0); }
    .halo { width: 420px; height: 420px; inset: 50% 0 auto; translate: 0 -50%; filter: blur(30px); }
    .stage :global(.phone) { width: min(300px, calc((100svh - 96px) * 9 / 19)); border-radius: 44px; padding: 10px; }
    .stage :global(.phone-notch) { top: 18px; width: 90px; height: 24px; }
    .stage :global(.phone-screen) { border-radius: 34px; }
    .dots-nav { display: none; }
    .chip { left: auto; right: -8px; bottom: auto; top: 16%; translate: 0; font-size: 13px; }
    .chip[data-chip="5"] { top: 44%; right: auto; left: -96px; }
    .chip[data-chip="6"] { top: 70%; }
    .steps { order: 1; gap: 0; padding: 18vh 0 24vh 56px; }
    .rail { display: block; position: absolute; left: 14px; top: 18vh; bottom: 24vh; width: 3px; background: var(--line); border-radius: 3px; }
    .rail .fill { position: absolute; inset: 0; background: var(--grad); border-radius: 3px; transform-origin: top; transform: scaleY(var(--p)); }
    .step { position: relative; min-height: 70vh; align-items: center; flex-direction: column; justify-content: center; gap: 12px; padding: 0; border: 0; background: none; opacity: .3; transform: translateX(-10px); }
    .step.is-active { opacity: 1; transform: none; }
    .step::before { content: ''; position: absolute; left: -49px; top: 50%; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line-strong); translate: 0 -50%; transition: background .4s, border-color .4s; }
    .step.is-active::before { background: var(--bb-cyan); border-color: var(--bb-cyan); }
    .step { align-items: flex-start; }
    .num { font-size: clamp(40px, 5vw, 64px); }
    .txt h3 { font-size: clamp(26px, 3vw, 36px); line-height: 1.1; }
    .txt p { font-size: 18px; max-width: 34ch; margin-top: 12px; }
  }

  /* ---------- Pantallas del teléfono ---------- */
  .screens { position: absolute; inset: 0; }
  .scr {
    position: absolute; inset: 0; font-size: 5.6cqw; line-height: 1.35; display: flex; flex-direction: column;
    background: var(--bb-white); color: var(--bb-black);
    opacity: 0; transform: translateY(1.2em); transition: opacity .5s var(--ease), transform .5s var(--ease); pointer-events: none; will-change: transform, opacity;
  }
  .scr.on { opacity: 1; transform: none; }
  .scr.past { transform: translateY(-1.2em); }
  .top, .hero-top { background: var(--bb-cyan); color: var(--bb-black); display: flex; align-items: center; gap: .6em; padding: 2.7em 1em .9em; font-size: 1.05em; flex: none; }
  .top b, .hero-top b { font-weight: 700; font-size: .9em; padding-left: .6em; border-left: 1.5px solid rgba(20,25,37,.35); }
  .hero-top { padding-bottom: 2.2em; border-radius: 0 0 1.6em 1.6em; }
  .lg { display: inline-flex; }
  .lg :global(img) { height: 1.6em !important; width: auto; }
  .body { padding: 1.1em 1em; display: flex; flex-direction: column; gap: .85em; flex: 1; min-height: 0; }
  .body.center { align-items: center; text-align: center; gap: .7em; }
  .body h4 { font-size: 1.3em; color: var(--bb-black); font-weight: 800; letter-spacing: -.01em; }
  .fld { display: flex; flex-direction: column; gap: .3em; }
  .fld small, .lbl { font-size: .8em; color: var(--bb-black); opacity: .65; font-weight: 600; letter-spacing: .02em; }
  .inp { display: flex; align-items: center; min-height: 2.8em; padding: 0 .9em; background: var(--bb-white); border: 1px solid #d9dbe0; border-radius: .8em; font-size: 1em; color: var(--bb-black); position: relative; }
  .inp.focus { border-color: var(--bb-purple); box-shadow: 0 0 0 .25em rgba(146,79,245,.18); }
  .btn-app { margin-top: auto; width: 100%; box-sizing: border-box; display: grid; place-items: center; min-height: 2.9em; border-radius: 8px; background: var(--bb-purple); color: #fff; font-weight: 700; font-size: 1em; }
  .btn-app.ghost { background: transparent; color: var(--bb-black); box-shadow: inset 0 0 0 1.5px var(--bb-black); }
  .badge-ok { display: inline-flex; align-items: center; gap: .55em; align-self: flex-start; padding: .55em .8em; border-radius: .8em; background: var(--bb-cyan-light); color: var(--bb-black); font-size: .85em; font-weight: 700; line-height: 1.25; }
  .badge-ok svg { flex: none; color: var(--bb-green); stroke-width: 3; }
  .badge-ok .dot { flex: none; width: .6em; height: .6em; border-radius: 50%; background: var(--bb-green); }
  .hint { display: flex; align-items: center; gap: .6em; padding: .8em .9em; border-radius: .9em; background: var(--bb-gray); color: var(--bb-black); font-size: .85em; font-weight: 600; }
  .hint svg { flex: none; color: var(--bb-cyan); }

  /* animaciones por pantalla: solo corren cuando .on se (re)aplica */
