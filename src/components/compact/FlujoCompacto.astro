---
import PhoneFrame from '../ui/PhoneFrame.astro';
import BrandMark from '../ui/BrandMark.astro';
import AppScreens from './AppScreens.astro';

const steps = [
  { t: 'Ingresa el RUC', d: 'Abre la app e ingresa el RUC del cliente.' },
  { t: 'Razón social al instante', d: 'El nombre aparece en línea con Gloria.' },
  { t: 'Define el monto', d: 'Un solo importe, sin cálculos aparte.' },
  { t: 'Genera el QR', d: 'Un toque y el código está listo.' },
  { t: 'Paga con cualquier billetera', d: 'La tienda paga con la app que ya usa.' },
  { t: 'Se registra en el ERP', d: 'Pago confirmado y viaja al ERP de Gloria.' },
  { t: 'Todo cuadra', d: 'Distribuidor y supervisor ven lo mismo.' },
];
---
<section class="section flujoc" id="como-funciona" aria-labelledby="flujoc-title">
  <div class="container">
    <div class="flujoc-wrap" data-flujoc data-desc={JSON.stringify(steps.map((s) => s.d))}>
      <header class="flujoc-head">
        <span class="eyebrow">Cómo funciona</span>
        <h2 class="h-section" id="flujoc-title">Del RUC al <span class="pill pill-cyan">cuadre</span></h2>
      </header>

      <div class="flujoc-stage">
        <div class="flujoc-halo" aria-hidden="true"></div>
        <PhoneFrame label="Simulación de la app BanBif Empresas, paso a paso">
          <AppScreens />
        </PhoneFrame>
      </div>

      <ol class="flujoc-steps" aria-label="Pasos del flujo">
        {steps.map((s, i) => (
          <li>
            <button type="button" class="flujoc-step" data-step={i} aria-label={`Paso ${i + 1}: ${s.t}`} aria-current="false">
              <span class="shape shape-line flujoc-num" aria-hidden="true">{i + 1}</span>
              <span class="flujoc-t" aria-hidden="true">{s.t}</span>
              <span class="flujoc-bar" aria-hidden="true"><i></i></span>
            </button>
          </li>
        ))}
      </ol>

      <div class="flujoc-cap" data-cap>
        <p class="flujoc-live" aria-live="polite"><b data-cap-t>{steps[0].t}.</b> <span data-cap-d>{steps[0].d}</span></p>
        <div class="flujoc-ctl" data-ctl hidden>
          <button type="button" class="flujoc-nav" data-prev aria-label="Paso anterior"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
          <button type="button" class="flujoc-nav" data-next aria-label="Paso siguiente"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </div>
    </div>

    <div class="flujoc-plat">
      <p class="flujoc-plat-t">Dos plataformas, <span>un solo cuadre</span></p>
      <div class="flujoc-plat-row">
        <span class="flujoc-chip flujoc-chip-c">App del distribuidor</span>
        <span class="flujoc-chip flujoc-chip-p">Web del supervisor</span>
        <svg class="flujoc-arrow" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
        <span class="flujoc-chip flujoc-chip-w">ERP de Gloria <BrandMark brand="gloria" size={16} /></span>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-flujoc]');
  if (root) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.flujoc-step')];
    const screens = [...root.querySelectorAll<HTMLElement>('.scr')];
    const capT = root.querySelector<HTMLElement>('[data-cap-t]')!;
    const capD = root.querySelector<HTMLElement>('[data-cap-d]')!;
    const ctl = root.querySelector<HTMLElement>('[data-ctl]')!;
    const stage = root.querySelector<HTMLElement>('.flujoc-stage')!;
    const MAP = [1, 2, 3, 4, 4, 5, 6]; // pasos 4 y 5 comparten la pantalla del QR
    const TXT = btns.map((b) => [b.getAttribute('aria-label')!.replace(/^Paso \d+: /, ''), '']);
    const DESC = JSON.parse(root.dataset.desc || '[]') as string[];
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let cur = -1;
    let visible = false;

    const setActive = (n: number) => {
      n = (n + btns.length) % btns.length;
      const sc = MAP[n];
      screens.forEach((s, i) => {
        s.classList.toggle('on', i === sc);
        s.classList.toggle('past', i < sc);
      });
      screens[4]?.classList.toggle('pay', n === 4);
      btns.forEach((b, i) => {
        b.classList.toggle('is-on', i === n);
        b.classList.toggle('is-done', i < n);
        b.setAttribute('aria-current', i === n ? 'step' : 'false');
      });
      capT.textContent = TXT[n][0] + '.';
      capD.textContent = DESC[n] || '';
      // reinicia la barra de progreso
      const bar = btns[n].querySelector<HTMLElement>('.flujoc-bar i')!;
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
      cur = n;
    };

    const sync = () => {
      const manual = rm.matches;
      root.classList.toggle('is-manual', manual);
      ctl.hidden = !manual;
      root.classList.toggle('is-paused', manual || !visible || document.hidden);
    };

    btns.forEach((b, i) => b.addEventListener('click', () => setActive(i)));
    root.querySelector('[data-prev]')!.addEventListener('click', () => setActive(cur - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => setActive(cur + 1));
    // El avance automático lo marca el fin de la barra de progreso del paso activo
    root.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'flujoc-fill' && !rm.matches) setActive(cur + 1);
    });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && cur < 0) setActive(0);
      sync();
    }, { threshold: 0.4 }).observe(stage);
    document.addEventListener('visibilitychange', sync);
    rm.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .flujoc { overflow: clip; }
  .flujoc .container { position: relative; }

  .flujoc-wrap { display: grid; gap: 22px; justify-items: center; text-align: center; }
  .flujoc-head { display: grid; justify-items: center; }
  .flujoc-head .h-section { margin-top: 14px; max-width: none; font-size: clamp(30px, 8vw, 44px); }

  /* Teléfono */
  .flujoc-stage { position: relative; display: grid; justify-items: center; }
  .flujoc-halo { position: absolute; inset: 12% 0 auto; margin-inline: auto; width: 240px; height: 240px; border-radius: 50%; background: radial-gradient(closest-side, rgba(32,166,255,.26), transparent); filter: blur(10px); }
  .flujoc-stage :global(.phone) { width: 210px; border-radius: 32px; padding: 7px; position: relative; }
  .flujoc-stage :global(.phone-notch) { top: 13px; width: 62px; height: 16px; }
  .flujoc-stage :global(.phone-screen) { border-radius: 26px; background: var(--bb-white); }

  /* Pasos: fila compacta de chips numerados */
  .flujoc-steps { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
  .flujoc-step {
    all: unset; box-sizing: border-box; cursor: pointer; width: 100%;
    display: grid; justify-items: center; gap: 7px; padding: 4px 0; border-radius: 12px;
  }
  .flujoc-step:focus-visible { outline: 2px solid var(--bb-cyan); outline-offset: 2px; }
  .flujoc-num {
    width: 100%; max-width: 44px; height: 40px; font-family: var(--font-display); font-weight: 800; font-size: 18px; line-height: 1;
    color: var(--muted); box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition: background .3s, color .3s, box-shadow .3s;
  }
  .flujoc-t { display: none; }
  .flujoc-bar { display: block; width: 100%; max-width: 44px; height: 3px; border-radius: 3px; background: var(--line-strong); overflow: hidden; }
  .flujoc-bar i { display: block; height: 100%; width: 0; background: var(--grad); border-radius: 3px; }
  .is-done .flujoc-bar i { width: 100%; opacity: .45; }
  .is-on .flujoc-num { background: var(--bb-cyan); color: var(--bb-black); box-shadow: none; }
  .is-on .flujoc-bar i { width: 0; animation: flujoc-fill 2.8s linear forwards; }
  .is-paused .is-on .flujoc-bar i { animation-play-state: paused; }
  .is-manual .is-on .flujoc-bar i { animation: none; width: 100%; }
  @keyframes flujoc-fill { from { width: 0; } to { width: 100%; } }

  /* Frase del paso activo */
  .flujoc-cap { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; width: 100%; }
  .flujoc-live { margin: 0; font-size: 16px; line-height: 1.35; color: var(--muted); max-width: 32ch; }
  .flujoc-live b { color: var(--text); font-weight: 700; }
  .flujoc-ctl { display: flex; gap: 8px; flex: none; }
  .flujoc-ctl[hidden] { display: none; }
  .flujoc-nav { all: unset; box-sizing: border-box; cursor: pointer; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--bb-purple); color: #fff; }
  .flujoc-nav:focus-visible { outline: 2px solid var(--bb-cyan); outline-offset: 2px; }

  /* Dos plataformas, un solo cuadre */
  .flujoc-plat { margin-top: 26px; display: grid; justify-items: center; gap: 12px; text-align: center; }
  .flujoc-plat-t { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 18px; letter-spacing: -.01em; }
  .flujoc-plat-t span { color: var(--bb-cyan); }
  .flujoc-plat-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 10px; }
  .flujoc-chip { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 12px; font-size: 14px; font-weight: 700; line-height: 1.2; color: var(--bb-black); }
  .flujoc-chip-c { background: var(--bb-cyan-light); }
  .flujoc-chip-p { background: var(--bb-purple-light); }
  .flujoc-chip-w { background: var(--bb-white); padding-right: 10px; }
  .flujoc-arrow { color: var(--bb-cyan); flex: none; }

  /* Escritorio: pasos a la izquierda, teléfono a la derecha */
  @media (min-width: 900px) {
    .flujoc-wrap {
      grid-template-columns: minmax(0, 1fr) 320px; grid-template-areas: "head stage" "steps stage" "cap stage";
      grid-template-rows: auto auto 1fr; column-gap: clamp(40px, 7vw, 110px); row-gap: 28px;
      justify-items: stretch; text-align: left; align-items: start; max-width: 940px; margin-inline: auto;
    }
    .flujoc-head { grid-area: head; justify-items: start; }
    .flujoc-head .h-section { font-size: clamp(38px, 4.4vw, 56px); }
    .flujoc-stage { grid-area: stage; grid-row: 1 / 4; align-self: center; justify-items: center; }
    .flujoc-stage :global(.phone) { width: 262px; border-radius: 40px; padding: 9px; }
    .flujoc-stage :global(.phone-notch) { top: 16px; width: 76px; height: 20px; }
    .flujoc-stage :global(.phone-screen) { border-radius: 32px; }
    .flujoc-halo { width: 380px; height: 380px; inset: 50% 0 auto; translate: 0 -50%; filter: blur(26px); }
    .flujoc-steps { grid-area: steps; grid-template-columns: 1fr; gap: 4px; }
    .flujoc-step { justify-items: stretch; grid-template-columns: auto 1fr; grid-template-rows: auto auto; align-items: center; column-gap: 16px; row-gap: 6px; padding: 8px 12px; border-radius: 16px; transition: background .3s; }
    .flujoc-step:hover { background: rgba(255,255,255,.05); }
    .flujoc-num { grid-row: 1 / 3; justify-self: center; width: 46px; height: 42px; }
    .flujoc-t { display: block; font-size: 18px; font-weight: 700; letter-spacing: -.01em; color: var(--muted); text-align: left; transition: color .3s; }
    .is-on .flujoc-t { color: var(--text); }
    .flujoc-bar { max-width: none; grid-column: 2; }
    .flujoc-cap { grid-area: cap; justify-content: flex-start; align-self: start; }
    .flujoc-live { font-size: 18px; max-width: 40ch; }
    .flujoc-plat { margin-top: 48px; grid-auto-flow: column; justify-content: center; align-items: center; gap: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flujoc-num, .flujoc-step { transition: none; }
  }
</style>
