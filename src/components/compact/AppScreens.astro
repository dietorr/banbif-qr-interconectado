---
// Las 7 pantallas de la app (copiadas de ComoFunciona). El padre alterna .on / .past / .pay.
import BrandMark from '../ui/BrandMark.astro';

const N = 25;
let seed = 7;
const rnd = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff;
const inFinder = (x: number, y: number) =>
  (x < 8 && y < 8) || (x >= N - 8 && y < 8) || (x < 8 && y >= N - 8);
let qr = '';
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) {
  if (!inFinder(x, y) && rnd() > 0.52) qr += `M${x} ${y}h1v1h-1z`;
}
const finders = [[0, 0], [N - 7, 0], [0, N - 7]];
const keys = ['1','2','3','4','5','6','7','8','9','','0','‹'];
const rows = [['Cliente 01','S/ •••'],['Cliente 02','S/ •••'],['Cliente 03','S/ •••'],['Cliente 04','S/ •••']];
---
<div class="screens" data-screens>
          <div class="scr on s1" data-screen="0">
            <div class="hero-top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body">
              <h4>Bienvenido</h4>
              <label class="fld"><small>Usuario</small><span class="inp">distribuidor01</span></label>
              <label class="fld"><small>Contraseña</small><span class="inp">••••••••</span></label>
              <span class="btn-app a-press">Ingresar</span>
            </div>
          </div>
          <!-- 2 RUC -->
          <div class="scr s2" data-screen="1">
            <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body">
              <h4>Nuevo cobro</h4>
              <label class="fld"><small>RUC del cliente</small>
                <span class="inp focus"><span class="ph">Ingresa el RUC</span><span class="typed mono">20•••••••••</span><i class="caret"></i></span>
              </label>
              <div class="hint"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg>Validación en línea con Gloria</div>
              <span class="btn-app">Buscar cliente</span>
            </div>
          </div>
          <!-- 3 Razón social -->
          <div class="scr s3" data-screen="2">
            <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body">
              <h4>Nuevo cobro</h4>
              <div class="fld"><small>Razón social</small>
                <div class="reveal-box"><span class="skel"></span><span class="name">Bodega Ejemplo S.A.C.</span></div>
              </div>
              <div class="fld"><small>RUC</small><span class="inp mono">20•••••••••</span></div>
              <div class="badge-ok"><i class="dot"></i>Cliente validado · Conectado con Gloria</div>
              <span class="btn-app">Continuar</span>
            </div>
          </div>
          <!-- 4 Monto -->
          <div class="scr s4" data-screen="3">
            <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body">
              <small class="lbl">Monto a cobrar</small>
              <div class="amount mono"><span>S/</span> <span>•</span><span>•</span><span>•</span><span>.</span><span>•</span><span>•</span></div>
              <div class="keypad">
                {keys.map((k, i) => <span class="key" style={`--i:${i}`}>{k}</span>)}
              </div>
              <span class="btn-app">Generar QR</span>
            </div>
          </div>
          <!-- 5 QR -->
          <div class="scr s5" data-screen="4">
            <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body center">
              <h4>Muestra este QR al cliente</h4>
              <div class="qr-wrap">
                <i class="ring r1"></i><i class="ring r2"></i>
                <svg class="qr" viewBox={`-1 -1 ${N + 2} ${N + 2}`} shape-rendering="crispEdges" aria-hidden="true">
                  <rect x="-1" y="-1" width={N + 2} height={N + 2} fill="#fff"/>
                  <path d={qr} fill="#141925"/>
                  {finders.map(([x, y]) => (
                    <g transform={`translate(${x} ${y})`}>
                      <rect width="7" height="7" fill="#141925"/><rect x="1" y="1" width="5" height="5" fill="#fff"/><rect x="2" y="2" width="3" height="3" fill="#141925"/>
                    </g>
                  ))}
                </svg>
              </div>
              <p class="help">Puede pagar desde cualquier billetera o banco</p>
              <div class="wallets" aria-hidden="true">
                <span style="--c:var(--bb-purple);--t:#fff">B1</span><span style="--c:var(--bb-cyan);--t:#141925">B2</span><span style="--c:var(--bb-purple-light);--t:#141925">B3</span><span style="--c:var(--bb-cyan-light);--t:#141925">B4</span><span style="--c:var(--bb-gray);--t:#141925">+</span>
              </div>
              <div class="waiting"><i></i>Esperando pago<span class="dots">…</span></div>
            </div>
          </div>
          <!-- 6 Pago confirmado -->
          <div class="scr s6" data-screen="5">
            <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body center">
              <div class="check-wrap">
                <svg viewBox="0 0 52 52" width="100%" height="100%" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle class="c-bg" cx="26" cy="26" r="24"/><circle class="c-ring" cx="26" cy="26" r="23" stroke-width="2.5"/><path class="c-tick" d="M15 27l8 8 14-16" stroke-width="4"/></svg>
              </div>
              <h4 class="ttl">Pago realizado</h4>
              <div class="erp-row">
                <span class="src"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg></span>
                <span class="track"><i class="packet"></i></span>
                <span class="dst"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg><b>ERP Gloria</b><BrandMark brand="gloria" size={14}/></span>
              </div>
              <div class="badge-ok st"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Registrado en el ERP</div>
              <span class="btn-app ghost">Nuevo cobro</span>
            </div>
          </div>
          <!-- 7 Cuadre -->
          <div class="scr s7" data-screen="6">
            <div class="top"><span class="lg"><BrandMark brand="banbif" variant="blanco" size={20}/></span><b>Empresas</b></div>
            <div class="body">
              <h4>Mis cobros del día</h4>
              <div class="tbl">
                <div class="tr th"><span>Cliente</span><span>Monto</span><span>Estado</span></div>
                {rows.map(([c, m], i) => (
                  <div class="tr" style={`--i:${i}`}>
                    <span>{c}</span><span class="mono" style="white-space:nowrap">{m}</span>
                    <span class="state"><em class="pend">Pendiente</em><em class="done"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Conciliado</em></span>
                  </div>
                ))}
              </div>
              <span class="btn-app">Cerrar ruta</span>
            </div>
          </div>
</div>
<style>
  .screens { position: absolute; inset: 0; container-type: inline-size; }
  .mono { font-family: var(--font-mono); }
  .scr {
    position: absolute; inset: 0; font-size: 5.6cqw; line-height: 1.35; display: flex; flex-direction: column;
    background: var(--bb-white); color: var(--bb-black);
    opacity: 0; transform: translateY(1.2em); transition: opacity .5s var(--ease), transform .5s var(--ease); pointer-events: none; will-change: transform, opacity;
  }
  .scr.on { opacity: 1; transform: none; }
  .scr.past { transform: translateY(-1.2em); }
  .top, .hero-top { background: var(--bb-cyan); color: var(--bb-black); display: flex; align-items: center; gap: .6em; padding: 2.7em 1em .9em; font-size: 1.05em; flex: none; }
  .top b, .hero-top b { font-weight: 700; font-size: .9em; padding-left: .6em; border-left: 1.5px solid rgba(20,25,37,.35); }
  .hero-top { padding-bottom: 2.2em; border-radius: 0 0 1.6em 1.6em; }
  .lg { display: inline-flex; }
  .lg :global(img) { height: 1.6em !important; width: auto; }
  .body { padding: 1.1em 1em; display: flex; flex-direction: column; gap: .85em; flex: 1; min-height: 0; }
  .body.center { align-items: center; text-align: center; gap: .7em; }
  .body h4 { font-size: 1.3em; color: var(--bb-black); font-weight: 800; letter-spacing: -.01em; }
  .fld { display: flex; flex-direction: column; gap: .3em; }
  .fld small, .lbl { font-size: .8em; color: var(--bb-black); opacity: .65; font-weight: 600; letter-spacing: .02em; }
  .inp { display: flex; align-items: center; min-height: 2.8em; padding: 0 .9em; background: var(--bb-white); border: 1px solid #d9dbe0; border-radius: .8em; font-size: 1em; color: var(--bb-black); position: relative; }
  .inp.focus { border-color: var(--bb-purple); box-shadow: 0 0 0 .25em rgba(146,79,245,.18); }
  .btn-app { margin-top: auto; width: 100%; box-sizing: border-box; display: grid; place-items: center; min-height: 2.9em; border-radius: 8px; background: var(--bb-purple); color: #fff; font-weight: 700; font-size: 1em; }
  .btn-app.ghost { background: transparent; color: var(--bb-black); box-shadow: inset 0 0 0 1.5px var(--bb-black); }
  .badge-ok { display: inline-flex; align-items: center; gap: .55em; align-self: flex-start; padding: .55em .8em; border-radius: .8em; background: var(--bb-cyan-light); color: var(--bb-black); font-size: .85em; font-weight: 700; line-height: 1.25; }
  .badge-ok svg { flex: none; color: var(--bb-green); stroke-width: 3; }
  .badge-ok .dot { flex: none; width: .6em; height: .6em; border-radius: 50%; background: var(--bb-green); }
  .hint { display: flex; align-items: center; gap: .6em; padding: .8em .9em; border-radius: .9em; background: var(--bb-gray); color: var(--bb-black); font-size: .85em; font-weight: 600; }
  .hint svg { flex: none; color: var(--bb-cyan); }

  /* animaciones por pantalla: solo corren cuando .on se (re)aplica */
  /* 1 */
  .s1 .a-press { animation: none; }
  .s1.on .a-press { animation: flujoc-press 1s 1.4s var(--ease) both; }
  @keyframes flujoc-press { 0%{transform:scale(1)} 40%{transform:scale(.95); filter:brightness(.85)} 100%{transform:scale(1)} }
  /* 2 */
  .s2 .typed { display: none; }
  .s2.on .ph { display: none; }
  .s2.on .typed { display: inline-block; overflow: hidden; white-space: nowrap; width: 11ch; animation: flujoc-typing 1.1s steps(11) .3s both; font-size: .95em; letter-spacing: .02em; }
  @keyframes flujoc-typing { from { width: 0 } to { width: 11ch } }
  .s2 .ph { color: #7d808a; }
  .caret { width: 2px; height: 1.2em; background: var(--bb-purple); margin-left: 2px; animation: flujoc-blink 1s steps(1) infinite; }
  @keyframes flujoc-blink { 50% { opacity: 0 } }
  /* 3 */
  .reveal-box { position: relative; min-height: 2.8em; display: flex; align-items: center; padding: 0 .9em; background: var(--bb-white); border: 1px solid #d9dbe0; border-radius: .8em; overflow: hidden; }
  .name { font-weight: 700; color: var(--bb-black); opacity: 0; }
  .skel { position: absolute; inset: .7em .9em; border-radius: .4em; background: linear-gradient(90deg, #e4e5e8 25%, #f6f6f7 50%, #e4e5e8 75%); background-size: 200% 100%; opacity: 0; }
  .s3 .name { opacity: 1; }
  .s3.on .name { animation: flujoc-fadein .4s 1s both; }
  .s3.on .skel { animation: flujoc-shimmer 1s linear 1 both, flujoc-fadeout .3s .9s forwards; opacity: 1; }
  .s3 .badge-ok, .s3 .btn-app { opacity: 1; }
  .s3.on .badge-ok { animation: flujoc-pop .5s 1.4s var(--ease) both; }
  .s3.on .btn-app { animation: flujoc-fadein .4s 1.7s both; }
  @keyframes flujoc-shimmer { from { background-position: 200% 0 } to { background-position: -200% 0 } }
  @keyframes flujoc-fadein { from { opacity: 0; transform: translateY(.4em) } to { opacity: 1; transform: none } }
  @keyframes flujoc-fadeout { to { opacity: 0 } }
  @keyframes flujoc-pop { from { opacity: 0; transform: scale(.85) } to { opacity: 1; transform: none } }
  /* 4 */
  .amount { font-size: 2.3em; font-weight: 700; color: var(--bb-black); letter-spacing: .04em; text-align: center; padding: .25em 0 .1em; }
  .amount span:first-child { opacity: .6; font-size: .6em; margin-right: .1em; }
  .s4.on .amount span:not(:first-child) { animation: flujoc-fadein .35s both; }
  .s4.on .amount span:nth-child(2) { animation-delay: .3s } .s4.on .amount span:nth-child(3) { animation-delay: .5s }
  .s4.on .amount span:nth-child(4) { animation-delay: .7s } .s4.on .amount span:nth-child(5) { animation-delay: .85s }
  .s4.on .amount span:nth-child(6) { animation-delay: 1s } .s4.on .amount span:nth-child(7) { animation-delay: 1.2s }
  .keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5em; }
  .key { display: grid; place-items: center; min-height: 2.5em; border-radius: .7em; background: var(--bb-gray); font-weight: 600; font-size: 1.1em; color: var(--bb-black); }
  .s4.on .key { animation: flujoc-keyflash .5s calc(.2s + var(--i) * .09s) both; }
  @keyframes flujoc-keyflash { 0%,100% { background: var(--bb-gray) } 40% { background: var(--bb-cyan-light) } }
  /* 5 */
  .qr-wrap { position: relative; width: 62%; aspect-ratio: 1; display: grid; place-items: center; margin-top: .3em; }
  .qr { position: relative; width: 100%; height: 100%; border-radius: .8em; border: 1px solid #d9dbe0; }
  .ring { position: absolute; inset: -.5em; border-radius: 1.2em; border: 2px solid var(--bb-cyan); opacity: 0; }
  .s5.on .ring { animation: flujoc-ring 2s var(--ease) infinite; }
  .s5.on .r2 { animation-delay: 1s; }
  @keyframes flujoc-ring { 0% { opacity: .8; transform: scale(.96) } 100% { opacity: 0; transform: scale(1.22) } }
  .s5.on .qr { animation: flujoc-pop .6s .1s var(--ease) both; }
  .help { font-size: .82em; color: var(--bb-black); opacity: .7; max-width: 20ch; }
  .wallets { display: flex; gap: .5em; }
  .wallets span { width: 2.3em; height: 2.3em; border-radius: 42% / 48%; background: var(--c); color: var(--t); display: grid; place-items: center; font-size: .72em; font-weight: 800; }
  .wallets { opacity: .35; transition: opacity .5s; }
  .s5.pay .wallets { opacity: 1; }
  .s5.pay .wallets span { animation: flujoc-pop .5s .1s var(--ease) both; }
  .s5.pay .wallets span:nth-child(2) { animation-delay: .25s } .s5.pay .wallets span:nth-child(3) { animation-delay: .3s }
  .s5.pay .wallets span:nth-child(4) { animation-delay: .55s } .s5.pay .wallets span:nth-child(5) { animation-delay: .7s }
  .waiting { margin-top: auto; display: inline-flex; align-items: center; gap: .6em; padding: .55em 1em; border-radius: 999px; background: var(--bb-cyan-light); color: var(--bb-black); font-weight: 700; font-size: .9em; }
  .waiting i { width: .6em; height: .6em; border-radius: 50%; background: var(--bb-green); }
  .s5.on .waiting i { animation: flujoc-blink 1s steps(1) infinite; }
  /* 6 */
  .check-wrap { width: 5.2em; height: 5.2em; margin-top: .4em; }
  .c-bg { fill: var(--bb-black); stroke: none; }
  .c-ring { stroke: var(--bb-cyan); } .c-tick { stroke: var(--bb-green); }
  .c-ring, .c-tick { stroke-dasharray: 150; stroke-dashoffset: 0; }
  .s6.on .c-bg { animation: flujoc-pop .5s var(--ease) both; transform-origin: center; }
  .s6.on .c-ring { animation: flujoc-draw .8s var(--ease) both; }
  .s6.on .c-tick { animation: flujoc-draw .4s .5s var(--ease) both; }
  @keyframes flujoc-draw { from { stroke-dashoffset: 150 } to { stroke-dashoffset: 0 } }
  .s6 .ttl { font-size: 1.4em; }
  .erp-row { display: flex; align-items: center; gap: .5em; width: 100%; margin-top: .5em; }
  .src, .dst { display: grid; justify-items: center; gap: .2em; color: var(--bb-black); font-size: .75em; }
  .dst { background: var(--bb-gray); padding: .6em .7em; border-radius: .8em; } .dst b { color: var(--bb-black); font-weight: 700; white-space: nowrap; }
  .dst :global(.bm-gloria) { margin-top: .1em; }
  .src { background: var(--bb-gray); padding: .6em; border-radius: .8em; }
  .track { flex: 1; height: 2px; background: repeating-linear-gradient(90deg, #b8bac2 0 4px, transparent 4px 8px); position: relative; }
  .packet { position: absolute; top: 50%; left: 0; width: .9em; height: .9em; border-radius: .3em; background: var(--bb-purple); translate: 0 -50%; opacity: 0; }
  .s6.on .packet { animation: flujoc-travel 1s .7s var(--ease) both; }
  @keyframes flujoc-travel { 0% { left: 0; opacity: 1 } 90% { opacity: 1 } 100% { left: calc(100% - .9em); opacity: 1 } }
  .s6 .st { align-self: center; }
  .s6.on .st { animation: flujoc-pop .5s 1.8s var(--ease) both; }
  /* 7 */
  .tbl { display: flex; flex-direction: column; background: var(--bb-white); border: 1px solid #d9dbe0; border-radius: .9em; overflow: hidden; }
  .tr { display: grid; grid-template-columns: 1.25fr 1fr 1.25fr; gap: .4em; align-items: center; padding: .7em .7em; font-size: .78em; border-top: 1px solid #ececef; color: var(--bb-black); font-weight: 600; }
  .tr.th { border-top: 0; background: var(--bb-gray); color: var(--bb-black); font-weight: 700; font-size: .72em; letter-spacing: .02em; }
  .state { position: relative; display: grid; }
  .state em { grid-area: 1/1; font-style: normal; font-size: .85em; font-weight: 700; padding: .3em .55em; border-radius: 99px; justify-self: start; display: inline-flex; align-items: center; gap: .3em; white-space: nowrap; }
  .state svg { color: var(--bb-green); }
  .pend { background: var(--bb-gray); color: var(--bb-black); }
  .done { background: var(--bb-cyan-light); color: var(--bb-black); opacity: 1; }
  .pend { opacity: 0; }
  .s7.on .pend { animation: flujoc-pendfade 1.9s calc(.2s) linear both; }
  .s7.on .done { animation: flujoc-fadein .45s calc(.6s + var(--i, 0) * .32s) both; }
  .s7.on .tr:nth-child(2) { --i: 0 } .s7.on .tr:nth-child(3) { --i: 1 } .s7.on .tr:nth-child(4) { --i: 2 } .s7.on .tr:nth-child(5) { --i: 3 }
  .s7 .done { opacity: 1; }
  .s7.on .tr:nth-child(2) .pend { animation: flujoc-pendfade .6s .1s both } .s7.on .tr:nth-child(3) .pend { animation: flujoc-pendfade .9s .1s both }
  .s7.on .tr:nth-child(4) .pend { animation: flujoc-pendfade 1.2s .1s both } .s7.on .tr:nth-child(5) .pend { animation: flujoc-pendfade 1.5s .1s both }
  @keyframes flujoc-pendfade { 0% { opacity: 1 } 90% { opacity: 1 } 100% { opacity: 0 } }

  @media (prefers-reduced-motion: reduce) {
    .scr, .scr * { transition: none !important; animation-delay: 0s !important; }
    .scr, .scr.past { transform: none; }
    .s7 .pend, .s7.on .pend { animation: none !important; opacity: 0; }
    .s3 .skel, .s3.on .skel { animation: none !important; opacity: 0; }
    .s2.on .typed { animation: none !important; width: 11ch; }
    .s5.on .ring { animation: none !important; }
  }
</style>
